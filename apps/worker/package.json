{
  "name": "@optimalen-nakup/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint \"src/**/*.ts\" --config ../../eslint.config.mjs --max-warnings=0",
    "start": "node dist/index.js",
    "test": "vitest run --config ../../vitest.unit.config.ts --root . --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@optimalen-nakup/adapter-sdk": "workspace:*",
    "@optimalen-nakup/ai": "workspace:*",
    "@optimalen-nakup/config": "workspace:*",
    "@optimalen-nakup/domain": "workspace:*",
    "@optimalen-nakup/security": "workspace:*",
    "cheerio": "1.2.0",
    "fast-xml-parser": "5.10.1",
    "openai": "6.49.0",
    "pino": "10.3.1",
    "playwright": "1.62.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
