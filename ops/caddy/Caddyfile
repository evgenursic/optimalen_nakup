{
	email {$ACME_EMAIL:ops@example.invalid}
	admin 0.0.0.0:2019
	metrics
	servers {
		protocols h1 h2 h3
	}
}

{$APP_DOMAIN} {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}

	log {
		output stdout
		format json
	}

	reverse_proxy web:3000 {
		health_uri /api/health
		health_interval 15s
		health_timeout 5s
		fail_duration 30s
	}
}
